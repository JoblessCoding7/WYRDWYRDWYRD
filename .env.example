# Copy to .env (git-ignored) and fill in. Never commit real values.

# `mock`   — local demo checkout at /checkout/mock, no external calls.
# `youzan` — price/stock/photos from Youzan; checkout redirects the buyer to Youzan to pay.
COMMERCE_PROVIDER=mock

# 有赞云 自用型无容器应用 (docs/youzan-integration.md)
YOUZAN_CLIENT_ID=
YOUZAN_CLIENT_SECRET=
# 店铺 kdt_id
YOUZAN_STORE_ID=

# The KT2 product in Youzan. SKU only needed when the item has several 规格.
YOUZAN_KT2_ITEM_ID=
YOUZAN_KT2_SKU_ID=
# Optional emergency override: always send buyers to this Youzan link.
YOUZAN_KT2_CHECKOUT_URL=

# Optional, for a future WeChat mini program shell.
YOUZAN_MINIPROGRAM_APP_ID=
YOUZAN_KT2_MINIPROGRAM_PATH=
